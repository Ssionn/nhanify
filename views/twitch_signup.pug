extends layout

block main 
  block header 
    h1(class="pageTitle") Sign Up
  .signUpMessages
    - let msgTypes = Object.keys(flash || {})
    if (msgTypes.length > 0) 
      each msgType in msgTypes
        each msg in flash[msgType]
          p(class=`${msgType}`) #{msg}
  block content
    .twitchUser
      p Sign up as #{twitchUsername}?
    .twitchForms
      form(class="createForm" action="/twitchSignup/Create" method="post")
        button(type="submit" class="twitchSignUpButton") Sign Up
      form(class="cancelForm" action="/twitchSignup/Cancel" method="post")
        button(type="submit" class="submit") Cancel
